<StackPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.tommaso.uniroma2.progettoISPW.init.VistaMenuPrincipale">
   <children>
      <VBox fx:id="dad" alignment="CENTER" spacing="10.0">
         <children>

            <Button fx:id="bottonePrenotazione" mnemonicParsing="false" onAction="#clickNuovaPrenotazione" prefHeight="51.0" prefWidth="151.0" text="Nuova Prenotazione" />
            <Button fx:id="bottoneLibreria" mnemonicParsing="false" onAction="#clickGestisciLibreria" prefHeight="51.0" prefWidth="151.0" text="Gestisci Libreria" />
         </children>
      </VBox>
   </children>
</StackPane>
