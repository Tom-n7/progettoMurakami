<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<StackPane prefHeight="300.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.tommaso.uniroma2.progettoISPW.view.mobile.VistaBarraTesto">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" spacing="30.0">
         <StackPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </StackPane.margin>
         <children>
            <Label fx:id="labelInfo" text="Label">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <TextField fx:id="inputField" />
            <HBox alignment="CENTER" prefHeight="232.0" prefWidth="580.0" spacing="30.0">
               <children>
                  <Button fx:id="bottoneConferna" mnemonicParsing="false" onAction="#tapSuConferma" prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: GREEN;" text="Conferma" />
                  <Button fx:id="bottoneEsci" mnemonicParsing="false" onAction="#tapSuEsci" prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: RED;" text="Esci" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
