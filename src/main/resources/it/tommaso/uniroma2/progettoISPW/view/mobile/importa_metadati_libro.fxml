                  <TextField fx:id="fieldAutore" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <TextField fx:id="fieldEdizione" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <TextField fx:id="fieldEditore" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <TextField fx:id="fieldLingua" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <TextField fx:id="fieldISNB" GridPane.columnIndex="1" GridPane.rowIndex="5" />
