                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" text="Titolo">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <Button fx:id="bottoneModTitolo" alignment="CENTER" mnemonicParsing="false" onAction="#tapModTitolo" prefHeight="40.0" prefWidth="40.0" text="Button" GridPane.columnIndex="2" />
                  <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" text="Autori" GridPane.rowIndex="1">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" text="Edizione" GridPane.rowIndex="2">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" text="Editore" GridPane.rowIndex="3">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" text="Lingua" GridPane.rowIndex="4">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" text="ISNB" GridPane.rowIndex="5">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <Button fx:id="bottoneModAutori" alignment="CENTER" mnemonicParsing="false" onAction="#tapModAutori" prefHeight="40.0" prefWidth="40.0" text="Button" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <Button fx:id="bottoneModEdizione" alignment="CENTER" mnemonicParsing="false" onAction="#tapModEdizione" prefHeight="40.0" prefWidth="40.0" text="Button" GridPane.columnIndex="2" GridPane.rowIndex="2" />
