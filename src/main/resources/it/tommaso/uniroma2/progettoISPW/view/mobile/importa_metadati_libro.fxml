            <HBox fx:id="HBoxAlta" alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="100.0" style="-fx-background-color: GREY;">
               <children>
                  <Button fx:id="bottoneEsci" mnemonicParsing="false" onAction="#tapSuEsci" prefHeight="50.0" prefWidth="50.0" text="Esci">
                     <HBox.margin>
                        <Insets left="30.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
            <GridPane prefHeight="984.0" prefWidth="720.0">
               <columnConstraints>
                  <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="30.0" prefWidth="50.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0" prefWidth="400.0" />
                  <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="30.0" prefWidth="30.0" />
               </columnConstraints>
               <rowConstraints>
