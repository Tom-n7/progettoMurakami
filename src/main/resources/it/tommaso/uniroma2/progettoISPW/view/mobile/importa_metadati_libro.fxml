            </GridPane>
            <HBox fx:id="HBoxBassa" alignment="CENTER" maxHeight="200.0" prefHeight="200.0" prefWidth="720.0" spacing="40.0" style="-fx-background-color: GREY; -fx-opacity: 100%;">
