<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<fx:root prefHeight="200.0" prefWidth="200.0" type="StackPane" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.tommaso.uniroma2.init.view.InitGController">
   <children>
      <VBox alignment="CENTER" spacing="10.0">
         <children>
            <Label fx:id="headLabel" text="Benvenuto" />
            <Button fx:id="bottonePrenotazione" mnemonicParsing="false" onAction="#clickNuovaPrenotazione" prefHeight="51.0" prefWidth="151.0" text="Nuova Prenotazione" />
            <Button fx:id="bottoneLibreria" mnemonicParsing="false" onAction="#clickGestisciLibreria" prefHeight="51.0" prefWidth="151.0" text="Gestisci Libreria" />
         </children>
      </VBox>
   </children>
</fx:root>
